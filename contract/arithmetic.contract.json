{
  "version": 1,
  "domain": "arithmetic",
  "cases": [
    { "name": "canonical_precedence", "input": "2+3*4", "expect": { "result": 14 } },
    { "name": "canonical_parentheses", "input": "(2+3)*4", "expect": { "result": 20 } },
    { "name": "canonical_left_assoc_div", "input": "8/2/2", "expect": { "result": 2 } },

    { "name": "dialect_add_equivalence", "input": "2 plus 3*4", "equivalentTo": "2+3*4", "expect": { "result": 14 } },
    { "name": "dialect_mul_equivalence", "input": "2+3×4", "equivalentTo": "2+3*4", "expect": { "result": 14 } },
    { "name": "dialect_div_equivalence", "input": "8÷2÷2", "equivalentTo": "8/2/2", "expect": { "result": 2 } },

    { "name": "fail_double_operator", "input": "2++3", "expectError": "syntax error" },
    { "name": "fail_trailing_operator", "input": "3/", "expectError": "syntax error" },
    { "name": "fail_unclosed_paren", "input": "(2+3", "expectError": "syntax error" },
    { "name": "fail_unknown_token", "input": "2 foo 3", "expectError": "unknown token" }
  ]
}
